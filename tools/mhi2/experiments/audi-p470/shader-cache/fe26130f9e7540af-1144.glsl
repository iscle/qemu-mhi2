precision highp float;
attribute vec3 a_normal;
attribute vec4 a_position;
varying mediump float v_brightness;
varying mediump float v_distToCenter;
varying mediump float v_fogFactor;
uniform vec2 u_ambient;
uniform float u_fogEnd;
uniform float u_fogStart;
uniform vec3 u_lightVec;
uniform mat4 u_mvpMatrix;
void main(){vec4 r[64];vec4 c[64];vec4 v[16];vec4 o[16];vec4 t;
for(int i=0;i<64;i++){r[i]=vec4(0.0);c[i]=vec4(0.0);}for(int i=0;i<16;i++){v[i]=vec4(0.0);o[i]=vec4(0.0);}
c[8]=vec4(2.0,0.0,0.0,0.0);
c[7]=vec4(u_ambient,0.0,0.0);
c[5]=vec4(u_fogEnd,0.0,0.0,0.0);
c[4]=vec4(u_fogStart,0.0,0.0,0.0);
c[6]=vec4(u_lightVec,0.0);
c[0]=u_mvpMatrix[0];
c[1]=u_mvpMatrix[1];
c[2]=u_mvpMatrix[2];
c[3]=u_mvpMatrix[3];
v[1]=vec4(a_normal,1.0);
v[0]=vec4(a_position);
t=vec4((v[0].yyyy)*(c[1].xyzw));r[0].xyzw=t.xyzw;
t=vec4((v[0].xxxx)*(c[0].xyzw)+(r[0].xyzw));r[0].xyzw=t.xyzw;
t=vec4(vec4(dot((v[0].xyzx).xyz,(v[0].xyzx).xyz)));r[1].x=t.x;
t=vec4(vec4(dot((v[1].xyzx).xyz,(c[6].xyzx).xyz)));r[1].y=t.y;
t=vec4((v[0].zzzz)*(c[2].xyzw)+(r[0].xyzw));r[0].xyzw=t.xyzw;
t=vec4((c[3].xyzw)+(r[0].xyzw));r[0].xyzw=t.xyzw;
t=vec4(vec4(inversesqrt(r[1].x)));r[1].x=t.x;
t=vec4(max(r[1].yyyy,c[8].yyyy));r[1].y=t.y;
t=vec4((r[1].yyyy)*(c[7].yyyy)+(c[7].xxxx));o[3].x=t.x;
t=vec4((r[0].wwww)*(c[4].xxxx));r[2].x=t.x;
t=vec4(vec4(1.0/(r[1].x)));r[1].x=t.x;
t=vec4((c[5].xxxx)+(r[2].xxxx));o[1].x=t.x;
t=vec4(r[0].xyzw);o[0].xyzw=t.xyzw;
t=vec4((r[1].xxxx)*(c[8].xxxx));o[2].x=t.x;
gl_Position=o[0];
v_brightness=o[3].x;
v_distToCenter=o[2].x;
v_fogFactor=o[1].x;
}
