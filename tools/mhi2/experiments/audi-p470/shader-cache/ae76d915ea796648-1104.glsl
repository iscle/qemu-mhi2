precision highp float;
attribute vec4 a_custom;
attribute vec4 a_position;
varying mediump float v_fogFactor;
uniform float u_fogEnd;
uniform float u_fogStart;
uniform mat4 u_mvpMatrix;
uniform vec3 u_origin;
uniform float u_roadGeometryWidthHalf;
uniform vec2 u_scaleH;
uniform float u_scaleXYZ;
uniform float u_widthScale;
void main(){vec4 r[64];vec4 c[64];vec4 v[16];vec4 o[16];vec4 t;
for(int i=0;i<64;i++){r[i]=vec4(0.0);c[i]=vec4(0.0);}for(int i=0;i<16;i++){v[i]=vec4(0.0);o[i]=vec4(0.0);}
c[10]=vec4(u_fogEnd,0.0,0.0,0.0);
c[9]=vec4(u_fogStart,0.0,0.0,0.0);
c[0]=u_mvpMatrix[0];
c[1]=u_mvpMatrix[1];
c[2]=u_mvpMatrix[2];
c[3]=u_mvpMatrix[3];
c[6]=vec4(u_origin,0.0);
c[7]=vec4(u_roadGeometryWidthHalf,0.0,0.0,0.0);
c[5]=vec4(u_scaleH,0.0,0.0);
c[4]=vec4(u_scaleXYZ,0.0,0.0,0.0);
c[8]=vec4(u_widthScale,0.0,0.0,0.0);
v[1]=vec4(a_custom);
v[0]=vec4(a_position);
t=vec4((v[0].xyzx)*(c[4].xxxx));r[0].xyz=t.xyz;
t=vec4((v[0].wwww)*(c[5].xxxx)+(c[5].yyyy));r[1].w=t.w;
t=vec4((c[6].xyzx)+(r[0].xyzx));r[1].xyz=t.xyz;
t=vec4(c[8].xxxx);r[0].w=t.w;
t=vec4((r[1].xyzx)*(r[1].wwww)+(r[0].xyzx));r[0].xyz=t.xyz;
t=vec4((r[0].wwww)*(c[7].xxxx));r[0].w=t.w;
t=vec4((v[1].xyzx)*(r[0].wwww)+(r[0].xyzx));r[0].xyz=t.xyz;
t=vec4((r[0].yyyy)*(c[1].xyzw));r[1].xyzw=t.xyzw;
t=vec4((r[0].xxxx)*(c[0].xyzw)+(r[1].xyzw));r[1].xyzw=t.xyzw;
t=vec4((r[0].zzzz)*(c[2].xyzw)+(r[1].xyzw));r[0].xyzw=t.xyzw;
t=vec4((c[3].xyzw)+(r[0].xyzw));r[0].xyzw=t.xyzw;
t=vec4((r[0].wwww)*(c[9].xxxx));r[1].x=t.x;
t=vec4((c[10].xxxx)+(r[1].xxxx));o[1].x=t.x;
t=vec4(r[0].xyzw);o[0].xyzw=t.xyzw;
gl_Position=o[0];
v_fogFactor=o[1].x;
}
